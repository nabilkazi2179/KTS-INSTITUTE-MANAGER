# ─────────────────────────────────────────────────────────────
# KTS Institute Manager — environment configuration
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────

# REQUIRED IN PRODUCTION. The app refuses to boot without it.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# production | development
FLASK_ENV=production

# ── Database ─────────────────────────────────────────────────
# Postgres connection string. STRONGLY recommended for production.
# Without it the app falls back to SQLite, which is EPHEMERAL on
# serverless hosts (Vercel/Lambda) — your data will disappear.
DATABASE_URL=

# ── First-run admin account ──────────────────────────────────
# Used only when the users table has no 'admin' row yet.
# If left blank in production a random password is generated and
# printed to the logs once.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@kts.com

# ── Telegram bot (optional) ──────────────────────────────────
TELEGRAM_BOT_TOKEN=
# Shared secret proving a webhook call really came from Telegram.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Register it:
#   curl "https://api.telegram.org/bot<TOKEN>/setWebhook?url=https://YOUR-DOMAIN/telegram/webhook&secret_token=<SECRET>"
TELEGRAM_WEBHOOK_SECRET=
TG_CODE_TTL_MINUTES=10

# ── Security tuning ──────────────────────────────────────────
LOGIN_RATE_LIMIT=10
MAX_FAILED_LOGINS=8
LOCKOUT_MINUTES=15
SESSION_HOURS=12

# ── Uploads & paging ─────────────────────────────────────────
MAX_UPLOAD_MB=16
PAGE_SIZE=50
# UPLOAD_FOLDER=/var/data/uploads

# ── Server ───────────────────────────────────────────────────
HOST=127.0.0.1
PORT=5000
# FLASK_DEBUG=1   # development only, NEVER set in production

# ── Optional shared default passwords ────────────────────────
# Leave blank so each new account gets a random one-time password.
# STUDENT_DEFAULT_PASSWORD=
# TRAINER_DEFAULT_PASSWORD=
