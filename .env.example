# ── KonkanTech Manager — environment configuration ──
# Copy this file to `.env` and fill in real values. NEVER commit the real .env.

# Flask session signing key. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-hex-string

# PostgreSQL connection string (REQUIRED in production — do not run on SQLite).
# Example: postgresql://kts_user:strongpassword@localhost:5432/kts_db
DATABASE_URL=postgresql://user:password@localhost:5432/kts_db

# First admin account, created automatically on first run.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-strong-password
ADMIN_FULLNAME=Super Admin
ADMIN_EMAIL=admin@konkantechnologies.in

# Optional: show full error pages (stack traces). Leave unset/0 in production.
DEBUG_ERRORS=0

# Optional: Telegram bot token (only if you use the Telegram notifications).
# TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
