# systemd service for KonkanTech Manager (gunicorn)
# Install:  sudo cp deploy/konkantech.service /etc/systemd/system/
#           sudo systemctl daemon-reload && sudo systemctl enable --now konkantech
# Adjust paths/user to match your server.

[Unit]
Description=KonkanTech Manager (Flask + gunicorn)
After=network.target postgresql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/konkantech
# .env is read automatically by the app (python-dotenv)
ExecStart=/var/www/konkantech/venv/bin/gunicorn --workers 3 --bind 127.0.0.1:8000 wsgi:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
